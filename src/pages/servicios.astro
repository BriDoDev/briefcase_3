---
import process from "../collections/process.json";
import services from "../collections/services.json";
import Layout from "../layouts/main.astro";
---

<Layout title="Servicios y proceso">
  <section class="px-4 pt-6 sm:px-6">
    <div class="max-w-6xl mx-auto flex flex-col gap-3 max-w-3xl">
      <h1 class="text-5xl font-semibold tracking-tighter text-ink">
        Servicios y cómo trabajo
      </h1>
      <p class="text-lg text-muted">
        Trabajo por proyecto, con alcance escrito antes de empezar. Si tu
        proceso no necesita software, te lo digo.
      </p>
    </div>
  </section>

  <section class="px-4 py-10 sm:px-6">
    <div class="grid max-w-6xl gap-4 mx-auto md:grid-cols-3">
      {
        services.map((service) => (
          <div class="flex flex-col gap-3 p-8 bg-surface rounded-md">
            <span class="kicker">{service.kicker}</span>
            <h2 class="text-xl font-semibold tracking-tight text-ink">
              {service.title}
            </h2>
            <p class="text-sm text-muted">{service.description}</p>
            <ul class="flex flex-col gap-2 pt-2 text-sm text-muted-strong">
              {service.bullets.map((bullet) => <li>· {bullet}</li>)}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="px-4 py-10 sm:px-6">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-col gap-2 mb-8 max-w-2xl">
        <h2 class="text-4xl font-semibold tracking-tighter text-ink">
          Cómo trabajamos
        </h2>
        <p class="text-muted">Cuatro pasos, sin sorpresas en el camino.</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          process.map((step) => (
            <div class="flex flex-col gap-3 p-8 bg-surface rounded-md">
              <span class="text-sm font-semibold text-accent-700">{step.step}</span>
              <h3 class="text-lg font-semibold tracking-tight text-ink">
                {step.title}
              </h3>
              <p class="text-sm text-muted">{step.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="px-4 py-10 pb-20 sm:px-6">
    <div class="grid max-w-6xl gap-4 mx-auto md:grid-cols-2">
      <div class="flex flex-col gap-3 justify-center p-11 bg-surface rounded-md">
        <h2 class="text-3xl font-semibold tracking-tighter text-ink">
          ¿Y si además lo grabamos?
        </h2>
        <p class="max-w-md text-muted">
          Algunos proyectos se convierten en un caso documentado. Si tu negocio
          acepta salir en video, el trabajo se documenta y llega a más gente
          como tú.
        </p>
      </div>
      <div class="flex flex-col gap-4 justify-center p-11 bg-mint-100 rounded-md">
        <h3 class="text-xl font-semibold tracking-tight text-mint-800">
          Cuéntame tu proceso
        </h3>
        <p class="text-sm text-mint-800">
          Contesto en menos de 48 horas con qué construiría y qué costaría.
        </p>
        <a href="/contacto" class="btn btn-primary self-start">
          Abrir el formulario
        </a>
      </div>
    </div>
  </section>
</Layout>
