---
import Button from "../components/button.astro";
import projects from "../collections/projects.json";
import Layout from "../layouts/main.astro";
import Slider from "../components/home/slider.astro";
---

<Layout title="Brian Dominguez Vazquez">
  <!-- Hero Section -->
  <section
    class="relative min-h-screen flex flex-col justify-center items-center px-6 md:px-12 py-32 grid-pattern"
  >
    <!-- Subtle gradient overlay -->
    <div
      class="absolute inset-0 bg-gradient-to-b from-white via-white/95 to-white dark:from-primary-950 dark:via-primary-950/95 dark:to-primary-950"
    >
    </div>

    <div class="relative z-10 max-w-4xl mx-auto text-center space-y-8">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 badge-accent">
        <span class="w-2 h-2 bg-accent rounded-full animate-pulse"></span>
        <span>Disponible para proyectos Q1 2026</span>
      </div>

      <!-- Name -->
      <h1
        class="text-4xl md:text-6xl lg:text-7xl font-bold text-primary-900 dark:text-white tracking-tighter"
      >
        Brian Dominguez Vazquez
      </h1>

      <!-- Title -->
      <h2
        class="text-2xl md:text-3xl lg:text-4xl font-semibold text-primary-500 dark:text-primary-400 tracking-tight"
      >
        Product Design Strategist
      </h2>

      <!-- Tagline -->
      <p
        class="text-lg md:text-xl text-primary-600 dark:text-primary-300 max-w-2xl mx-auto leading-relaxed"
      >
        Transformando interfaces complejas en
        <strong class="text-primary-900 dark:text-white font-semibold"
          >resultados de negocio medibles</strong
        >
        para SaaS y Enterprise.
      </p>

      <!-- CTAs -->
      <div
        class="flex flex-col sm:flex-row gap-4 justify-center items-center pt-4"
      >
        <Button
          variant="primary"
          size="large"
          text="Ver Estudios de Caso (ROI)"
          link="#proyectos"
        />
        <Button
          variant="secondary"
          size="large"
          text="Agendar Llamada"
          link="https://wa.me/5215580858318"
        />
      </div>

      <!-- Trust indicators -->
      <div class="pt-12 flex flex-col items-center gap-4">
        <p class="text-sm text-primary-400 dark:text-primary-500 uppercase tracking-wider">
          Experiencia en
        </p>
        <div class="flex flex-wrap justify-center gap-6 text-primary-400 dark:text-primary-500">
          <span class="text-sm font-medium">SaaS B2B</span>
          <span class="text-primary-200 dark:text-primary-700">·</span>
          <span class="text-sm font-medium">Enterprise</span>
          <span class="text-primary-200 dark:text-primary-700">·</span>
          <span class="text-sm font-medium">Fintech</span>
          <span class="text-primary-200 dark:text-primary-700">·</span>
          <span class="text-sm font-medium">E-commerce</span>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
      <svg
        class="w-6 h-6 text-primary-300 dark:text-primary-600"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
      </svg>
    </div>
  </section>

  <!-- About Section -->
  <section class="py-24 px-6 md:px-12 bg-primary-50 dark:bg-primary-900/50">
    <div class="max-w-5xl mx-auto">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="space-y-6">
          <h2
            class="text-3xl md:text-4xl font-bold text-primary-900 dark:text-white tracking-tight"
          >
            El puente entre el Diseño y el Negocio
          </h2>
          <div class="space-y-4 text-primary-600 dark:text-primary-300">
            <p>
              No entrego solo pantallas bonitas. Entrego
              <strong class="text-primary-900 dark:text-white"
                >sistemas de diseño escalables</strong
              >
              y flujos de usuario optimizados para la conversión.
            </p>
            <p>
              Hablo el idioma de tus desarrolladores —puedo leer código,
              entender limitaciones técnicas y diseñar con
              <strong class="text-accent">feasibility</strong> en mente— y
              entiendo las métricas que importan a tus inversores: CAC, LTV,
              Churn Rate y NPS.
            </p>
            <p>
              Con más de 4 años de experiencia en productos digitales, he
              trabajado con equipos de producto, ingeniería y C-level para
              alinear el diseño con los objetivos de negocio.
            </p>
          </div>
          <div class="flex gap-4 pt-4">
            <Button variant="primary" text="Conocer más" link="/about" />
            <Button
              variant="ghost"
              text="LinkedIn"
              link="https://www.linkedin.com/in/bridodev/"
            />
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div class="card space-y-2">
            <span class="text-3xl font-bold text-accent">4+</span>
            <p class="text-sm text-primary-500 dark:text-primary-400">
              Años de experiencia
            </p>
          </div>
          <div class="card space-y-2">
            <span class="text-3xl font-bold text-accent">20+</span>
            <p class="text-sm text-primary-500 dark:text-primary-400">
              Proyectos entregados
            </p>
          </div>
          <div class="card space-y-2">
            <span class="text-3xl font-bold text-accent">B2B</span>
            <p class="text-sm text-primary-500 dark:text-primary-400">
              Enfoque SaaS & Enterprise
            </p>
          </div>
          <div class="card space-y-2">
            <span class="text-3xl font-bold text-accent">ROI</span>
            <p class="text-sm text-primary-500 dark:text-primary-400">
              Diseño orientado a resultados
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section class="py-24 px-6 md:px-12">
    <div class="max-w-5xl mx-auto">
      <div class="text-center space-y-4 mb-16">
        <h2
          class="text-3xl md:text-4xl font-bold text-primary-900 dark:text-white tracking-tight"
        >
          Servicios Estratégicos
        </h2>
        <p class="text-lg text-primary-500 dark:text-primary-400 max-w-2xl mx-auto">
          Soluciones de diseño enfocadas en generar impacto medible en tu
          negocio.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        <!-- Service 1 -->
        <div class="card service-card space-y-4">
          <div
            class="w-12 h-12 rounded-lg bg-accent/10 flex items-center justify-center"
          >
            <svg
              class="w-6 h-6 text-accent"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-primary-900 dark:text-white">
            Auditoría de UX & CRO
          </h3>
          <p class="text-primary-500 dark:text-primary-400 text-sm">
            Análisis profundo de tu producto para identificar fricciones y
            oportunidades de optimización de conversión. Entregables
            accionables con métricas de impacto esperado.
          </p>
          <div class="flex flex-wrap gap-2 pt-2">
            <span class="badge">Conversion Rate</span>
            <span class="badge">User Research</span>
          </div>
        </div>

        <!-- Service 2 -->
        <div class="card service-card space-y-4">
          <div
            class="w-12 h-12 rounded-lg bg-accent/10 flex items-center justify-center"
          >
            <svg
              class="w-6 h-6 text-accent"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-primary-900 dark:text-white">
            Sistemas de Diseño Escalables
          </h3>
          <p class="text-primary-500 dark:text-primary-400 text-sm">
            Creación e implementación de Design Systems que aceleran el
            desarrollo, garantizan consistencia y reducen deuda técnica de UI.
          </p>
          <div class="flex flex-wrap gap-2 pt-2">
            <span class="badge">Figma</span>
            <span class="badge">Tokens</span>
            <span class="badge">Documentación</span>
          </div>
        </div>

        <!-- Service 3 -->
        <div class="card service-card space-y-4">
          <div
            class="w-12 h-12 rounded-lg bg-accent/10 flex items-center justify-center"
          >
            <svg
              class="w-6 h-6 text-accent"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-primary-900 dark:text-white">
            Product Strategy & Prototipado
          </h3>
          <p class="text-primary-500 dark:text-primary-400 text-sm">
            Desde la ideación hasta prototipos de alta fidelidad. Validación
            rápida de hipótesis con usuarios reales antes de invertir en
            desarrollo.
          </p>
          <div class="flex flex-wrap gap-2 pt-2">
            <span class="badge">Discovery</span>
            <span class="badge">Prototyping</span>
            <span class="badge">Testing</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Projects Section -->
  <section id="proyectos" class="py-24 px-6 md:px-12 bg-primary-50 dark:bg-primary-900/50 overflow-hidden">
    <Slider
      title="Estudios de Caso"
      items={projects}
      bgId="background-blur-projects"
      type="projects"
    />
  </section>

  <!-- CTA Section -->
  <section class="py-24 px-6 md:px-12">
    <div class="max-w-3xl mx-auto text-center space-y-8">
      <h2
        class="text-3xl md:text-4xl font-bold text-primary-900 dark:text-white tracking-tight"
      >
        ¿Listo para optimizar tu producto?
      </h2>
      <p class="text-lg text-primary-500 dark:text-primary-400">
        Hablemos de cómo reducir tu Churn Rate o mejorar tu Conversión. Sin
        compromiso, solo estrategia.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button
          variant="primary"
          size="large"
          text="Agendar Consulta"
          link="https://wa.me/5215580858318"
        />
        <Button
          variant="secondary"
          size="large"
          text="contacto@brian-dominguez.dev"
          link="mailto:contacto@brian-dominguez.dev"
        />
      </div>
    </div>
  </section>
</Layout>
