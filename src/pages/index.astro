---
import Button from "../components/button.astro";
import projects from "../collections/projects.json";
import certifications from "../collections/certifications.json";
import Separator from "../components/home/separator.astro";
import Writings from "../components/home/writings.astro";
import Layout from "../layouts/main.astro";
import Slider from "../components/home/slider.astro";
---

<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
/>

<Layout title="Brian Domínguez Vázquez">
  <!-- antes: h-screen overflow-y-scroll snap-y snap-mandatory scroll-smooth -->
  <div id="SnapMandatory" class="overflow-x-hidden snap-none">
    <!-- Hero section -->
    <section class="min-h-screen h-dvh image-hero__container desktop z-10">
      <div class="image-hero__container--item p-12">
        <h1>UI/UX Designer</h1>
        <p class="text-lg text-gray-700 leading-relaxed max-w-3xl">
          Mi experiencia en UI/UX me permite ser el
          <strong class="text-pink font-bold"
            >puente entre diseño y desarrollo</strong
          >. Traduzco visiones creativas en
          <strong class="text-xiketic font-semibold"
            >interfaces funcionales e intuitivas</strong
          >, garantizando que el producto final sea
          <strong class="text-pink font-bold">técnicamente sólido</strong> y
          <strong class="text-xiketic font-semibold">fácil de usar</strong>.
        </p>

        <Button
          variant="primary"
          text="Contacto Profesional"
          link="mailto:contacto@brian-dominguez.dev"
        />
      </div>
      <div class="image-hero__container--item p-12">
        <h1>Frontend Developer</h1>
        <p class="text-lg text-gray-700 leading-relaxed max-w-3xl">
          Con <strong class="text-pink font-bold"
            >más de 4 años de experiencia</strong
          >, me especializo en construir
          <strong class="text-xiketic font-semibold"
            >aplicaciones web robustas y escalables</strong
          >
          con tecnologías como React.js. Mi rol a menudo incluye
          <strong class="text-pink font-bold">liderar proyectos</strong>,
          colaborar en equipos multidisciplinarios y asegurar la entrega de un
          producto final pulido y de <strong class="text-pink font-semibold"
            >alto rendimiento</strong
          >.
        </p>
        <Button
          variant="secondary"
          text="Ver mi contenido"
          link="https://www.youtube.com/@bridodev"
        />
      </div>
    </section>
  </div>

  <section
    class="items-start md:items-center min-h-screen h-dvh image-hero__container mobile z-10 right"
  >
    <div class="image-hero__container--item p-12 pr-32 md:pb-36">
      <h1>UI/UX Designer</h1>
      <p class="text-lg text-gray-700 leading-relaxed max-w-3xl">
        Mi experiencia en UI/UX me permite ser el
        <strong class="text-pink font-bold"
          >puente entre diseño y desarrollo</strong
        >. Traduzco visiones creativas en
        <strong class="text-xiketic font-semibold"
          >interfaces funcionales e intuitivas</strong
        >, garantizando que el producto final sea
        <strong class="text-pink font-bold">técnicamente sólido</strong> y
        <strong class="text-xiketic font-semibold">fácil de usar</strong>.
      </p>
      <Button
        variant="primary"
        text="Contacto Profesional"
        link="mailto:contacto@brian-dominguez.dev"
      />
    </div>
  </section>

  <section
    class="items-start md:items-center min-h-screen h-dvh image-hero__container mobile z-10 left"
  >
    <div class="image-hero__container--item p-12 pl-36 md:pb-36">
      <h1>Frontend Developer</h1>
      <p class="text-lg text-gray-700 leading-relaxed max-w-3xl">
        Con <strong class="text-pink font-bold"
          >más de 4 años de experiencia</strong
        >, me especializo en construir
        <strong class="text-xiketic font-semibold"
          >aplicaciones web robustas y escalables</strong
        >
        con tecnologías como React.js. Mi rol a menudo incluye
        <strong class="text-pink font-bold">liderar proyectos</strong>,
        colaborar en equipos multidisciplinarios y asegurar la entrega de un
        producto final pulido y de <strong class="text-pink font-semibold"
          >alto rendimiento</strong
        >.
      </p>
      <Button
        variant="primary"
        text="Ver mi contenido"
        link="https://www.youtube.com/@bridodev"
      />
    </div>
  </section>

  <section class="items-center min-h-screen z-10 py-12 px-6">
    <div
      class="flex flex-col justify-center items-center gap-4 max-w-5xl mx-auto text-center"
    >
      <h1 class="text-4xl md:text-5xl font-bold text-xiketic">Sobre mí</h1>
      <p class="text-lg text-gray-700 leading-relaxed max-w-3xl">
        Hola, soy <strong class="text-pink font-bold"
          >Brian Domínguez Vázquez</strong
        >. Más allá de mi rol profesional, encuentro una gran satisfacción en
        <strong class="text-xiketic font-semibold">compartir lo que sé</strong>
        sobre tecnología y desarrollo.
        <br /><br />
        Lo hago a través de proyectos personales que disfruto, aplicando mis conocimientos
        en el <strong class="text-pink font-bold">diseño de interfaces</strong> y
        explorando el <strong class="text-pink font-bold"
          >desarrollo de videojuegos</strong
        >. Mi objetivo con los videos que creo sobre estos temas es simple:
        <strong class="text-xiketic font-semibold"
          >ser de ayuda para quien esté aprendiendo</strong
        >.
      </p>

      <div class="mt-2 flex gap-4 flex-col md:flex-row">
        <Button text="Conóceme" link="/about" />
        <Button
          variant="secondary"
          text="Contacto Profesional"
          link="mailto:contacto@brian-dominguez.dev"
        />
      </div>

      <div class="swiper image-slider w-full max-w-5xl px-4 mt-8">
        <div class="swiper-wrapper">
          <div class="swiper-slide p-4">
            <img
              src="./assets/images/SD1.webp"
              alt="Slide 1"
              class="w-full aspect-video object-cover rounded-xl shadow"
            />
          </div>
          <div class="swiper-slide p-4">
            <img
              src="./assets/images/Game3.webp"
              alt="Slide 3"
              class="w-full aspect-video object-cover rounded-xl shadow"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Certificaciones -->
  <Slider
    title="Mis certificaciones"
    items={certifications}
    bgId="background-blur-certifications"
    type="certifications"
  />

  <!-- Proyectos -->
  <Slider
    title="Algunos de mis últimos trabajos"
    items={projects}
    bgId="background-blur-projects"
    type="projects"
  />
</Layout>

<script type="module">
  import Swiper from "https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.mjs";

  new Swiper(".image-slider", {
    loop: true,
    slidesPerView: 1,
    spaceBetween: 24,
    autoplay: {
      delay: 5000,
      disableOnInteraction: false,
    },
  });
</script>

<script type="module">
  // Util: devuelve el primer background-color NO transparente (del nodo hacia arriba).
  function getEffectiveBgColor(el) {
    let node = el;
    while (node) {
      const c = getComputedStyle(node).backgroundColor;
      if (c && c !== "rgba(0, 0, 0, 0)" && c !== "transparent") return c;
      node = node.parentElement;
    }
    // fallback al body
    return getComputedStyle(document.body).backgroundColor || "#ffffff";
  }

  // Crea un fade absoluto en el borde indicado de la sección s.
  function addEdgeFade(s, edge, toColor, heightPx = 64) {
    const fade = document.createElement("div");
    fade.style.position = "absolute";
    fade.style.pointerEvents = "none";
    fade.style.left = "0";
    fade.style.right = "0";
    fade.style.height = heightPx + "px";
    fade.style.zIndex = "10";
    // gradiente según borde
    if (edge === "bottom") {
      fade.style.bottom = "0";
      fade.style.backgroundImage = `linear-gradient(to bottom, rgba(0,0,0,0), ${toColor})`;
    } else {
      fade.style.top = "0";
      fade.style.backgroundImage = `linear-gradient(to top, rgba(0,0,0,0), ${toColor})`;
    }
    s.appendChild(fade);
  }

  // Aplica máscara de desvanecido inferior a imágenes "hero" para evitar corte duro.
  function applyImageSoftMask(container, percent = 12) {
    const imgs = container.querySelectorAll("img, picture, video, canvas");
    imgs.forEach((img) => {
      img.style.webkitMaskImage = `linear-gradient(to bottom, black ${100 - percent}%, transparent 100%)`;
      img.style.maskImage = `linear-gradient(to bottom, black ${100 - percent}%, transparent 100%)`;
    });
  }

  document.addEventListener("DOMContentLoaded", () => {
    const sections = Array.from(document.querySelectorAll("section"));

    sections.forEach((s, idx) => {
      // asegurar posicionamiento relativo para poder colocar overlays
      s.style.position ||= "relative";

      // color del anterior y del siguiente (o body si no hay)
      const prev = sections[idx - 1];
      const next = sections[idx + 1];

      const prevColor = prev
        ? getEffectiveBgColor(prev)
        : getEffectiveBgColor(document.body);
      const nextColor = next
        ? getEffectiveBgColor(next)
        : getEffectiveBgColor(document.body);

      // fade superior hacia el color de la sección anterior
      addEdgeFade(s, "top", prevColor, 56);
      // fade inferior hacia el color de la sección siguiente
      addEdgeFade(s, "bottom", nextColor, 72);

      // Si esta sección tiene un "hero" con imagen, suaviza el borde inferior de la imagen.
      // Ajusta el selector a tus contenedores de hero:
      if (s.classList.contains("image-hero__container")) {
        applyImageSoftMask(s, 14); // 14% de desvanecido inferior
      }
    });
  });
</script>
