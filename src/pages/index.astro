---
import portfolio from "../collections/projects.json";
import services from "../collections/services.json";
import work from "../collections/work.json";
import Media from "../components/media.astro";
import ProjectCard from "../components/project-card.astro";
import WorkCard from "../components/work-card.astro";
import Layout from "../layouts/main.astro";

const stats = [
	{ value: "5+ años", label: "construyendo software en producción" },
	{ value: "FinTech", label: "pagos, 2FA, biometría y KYC" },
	{ value: "80%", label: "menos tiempo en un proceso de facturación" },
	{
		value: "Web, iOS y Android",
		label: "publicado en App Store y Google Play",
	},
];

const socials = [
	{ name: "YouTube", url: "#" },
	{ name: "TikTok", url: "#" },
	{ name: "Instagram", url: "#" },
	{ name: "LinkedIn", url: "https://www.linkedin.com/in/bridodev/" },
	{ name: "GitHub", url: "https://github.com/bridodev" },
];
---

<Layout>
  <!-- Hero -->
  <section class="px-4 pt-6 sm:px-6">
    <div
      class="grid max-w-6xl gap-10 p-10 mx-auto text-white md:p-14 bg-ink-deep rounded-lg lg:grid-cols-[1.15fr_1fr] lg:items-center"
    >
      <div class="flex flex-col gap-5">
        <span class="text-xs tracking-[0.12em] uppercase text-white/60">
          Brian Domínguez · Ingeniero de software · CDMX
        </span>
        <h1 class="text-5xl font-semibold tracking-tighter md:text-6xl">
          Digitalizo negocios
        </h1>
        <p class="max-w-xl text-lg text-white/75">
          Llevo más de cinco años construyendo software en producción: apps de
          cliente, portales, back offices y aplicaciones móviles. Encuentro el
          proceso manual que está frenando un negocio y construyo la
          herramienta que lo resuelve.
        </p>
        <div class="flex flex-col gap-3 pt-2 sm:flex-row">
          <a href="/contacto" class="btn" style="background:#fff; color:var(--color-ink)">
            Cuéntame tu proceso
          </a>
          <a href="/projects" class="btn btn-on-dark">Ver proyectos</a>
        </div>
        <div class="flex flex-wrap gap-5 pt-4 text-sm">
          {
            socials.map((social) => (
              <a href={social.url} class="text-white/70 hover:text-white">
                {social.name}
              </a>
            ))
          }
        </div>
      </div>
      <div class="h-64 overflow-hidden lg:h-96 rounded-md">
        <Media src="/assets/images/profile.jpg" alt="Brian Domínguez" />
      </div>
    </div>
  </section>

  <!-- Métricas -->
  <section class="px-4 py-12 sm:px-6">
    <div class="grid max-w-6xl gap-4 mx-auto sm:grid-cols-2 lg:grid-cols-4">
      {
        stats.map((stat) => (
          <div class="flex flex-col gap-1 p-7 bg-surface rounded-md">
            <span class="text-2xl font-semibold tracking-tight text-ink">
              {stat.value}
            </span>
            <span class="text-sm text-muted">{stat.label}</span>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Servicios -->
  <section class="px-4 py-12 sm:px-6">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-col gap-4 mb-8 md:flex-row md:items-end md:justify-between">
        <div class="flex flex-col gap-2 max-w-2xl">
          <h2 class="text-4xl font-semibold tracking-tighter text-ink">
            Qué puedo construir
          </h2>
          <p class="text-muted">
            Lo mismo que hago para una institución financiera, a la escala de tu
            negocio.
          </p>
        </div>
        <a href="/servicios" class="btn btn-ghost self-start">Servicios y proceso →</a>
      </div>
      <div class="grid gap-4 md:grid-cols-3">
        {
          services.map((service) => (
            <div class="flex flex-col gap-3 p-8 bg-surface rounded-md">
              <span class="kicker">{service.kicker}</span>
              <h3 class="text-xl font-semibold tracking-tight text-ink">
                {service.title}
              </h3>
              <p class="text-sm text-muted">{service.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Proyectos -->
  <section class="px-4 py-12 pb-20 sm:px-6">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-col gap-4 mb-8 md:flex-row md:items-end md:justify-between">
        <div class="flex flex-col max-w-2xl gap-2">
          <h2 class="text-4xl font-semibold tracking-tighter text-ink">
            Lo que ya construí
          </h2>
          <p class="text-muted">
            Trabajo publicado que puedes abrir, y el software en producción que
            vive detrás de un login.
          </p>
        </div>
        <a href="/projects" class="self-start btn btn-ghost">Ver todos los proyectos →</a>
      </div>

      <div class="grid gap-4 md:grid-cols-3">
        {portfolio.slice(0, 3).map((project) => <ProjectCard project={project} />)}
      </div>

      <h3 class="mt-10 mb-4 kicker">Software en producción</h3>
      <div class="grid gap-4 md:grid-cols-3">
        {work.slice(0, 3).map((item) => <WorkCard item={item} />)}
      </div>
    </div>
  </section>
</Layout>
