---
import FloatingContact from "../components/FloatingContact.astro";
import Footer from "../components/footer.astro";
import Header from "../components/header.astro";
import SquareLines from "../components/square-lines.astro";
import { SEO } from "astro-seo";
import "aos/dist/aos.css";

const { title = "", lang = "es" } = Astro.props;

const site = Astro.site;
const canonicalURL = new URL(Astro.url.pathname, site).toString();
const resolvedImageWithDomain = new URL("/meta/opengraph.png", site).toString();

const makeTitle = title
  ? `${title} | Product Design Strategist`
  : "Brian Dominguez Vazquez – Product Design Strategist";
---

<!doctype html>
<html lang={lang} class="h-full scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO y redes sociales -->
    <SEO
      title={makeTitle}
      description="Product Design Strategist especializado en SaaS y Enterprise. Transformo interfaces complejas en resultados de negocio medibles: sistemas de diseño escalables, auditorías de UX y optimización de conversión."
      canonical={canonicalURL}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: "website",
          title: makeTitle,
          image: resolvedImageWithDomain,
        },
        image: {
          alt: "Brian Dominguez Vazquez – Product Design Strategist",
        },
      }}
    />

    <meta http-equiv="Content-Language" content="es" />

    <!-- Iconografía y fuentes -->
    <link rel="icon" type="image/png" href="/assets/favicon.png" />
    <link rel="stylesheet" href="https://use.typekit.net/lap0far.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/icon?family=Material+Icons"
      rel="stylesheet"
    />

    <!-- Estilos globales -->
    <script src="../assets/css/main.css"></script>

    <!-- Modo oscuro (evita parpadeo inicial) -->
    <script is:inline>
      if (typeof Storage !== "undefined") {
        if (localStorage.getItem("dark_mode") === "true") {
          document.documentElement.classList.add("dark");
        }
      }
    </script>

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-FEPRLMTYFE"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-FEPRLMTYFE");
    </script>
  </head>

  <body
    class="bg-white dark:bg-primary-950 text-primary-900 dark:text-white h-full font-sans antialiased"
  >
    <Header />
    <main class="pt-20">
      <slot />
    </main>
    <Footer />
    <FloatingContact />

    <!-- JS global -->
    <script src="../assets/js/main.js"></script>
    <script src="../assets/js/aos-init.js"></script>
  </body>
</html>
