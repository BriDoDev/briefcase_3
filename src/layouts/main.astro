---
import { ViewTransitions } from "astro:transitions";
import { SEO } from "astro-seo";
import FloatingContact from "../components/FloatingContact.astro";
import Footer from "../components/footer.astro";
import Header from "../components/header.astro";
import { getLangFromUrl, routes, useTranslations } from "../i18n/ui";
import "../assets/css/main.css";

const { title = "", page } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const site = Astro.site;
const canonicalURL = new URL(Astro.url.pathname, site).toString();
const resolvedImageWithDomain = new URL("/meta/opengraph.png", site).toString();

const makeTitle = title
	? `${title} | ${t.meta.titleSuffix}`
	: t.meta.defaultTitle;
---

<!doctype html>
<html lang={lang} class="h-full scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO y redes sociales -->
    <SEO
      title={makeTitle}
      description={t.meta.description}
      canonical={canonicalURL}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: "website",
          title: makeTitle,
          image: resolvedImageWithDomain,
        },
        image: {
          alt: t.meta.imageAlt,
        },
      }}
    />

    <meta http-equiv="Content-Language" content={lang} />

    <!-- Alternativas de idioma (solo en las páginas que existen en ambos) -->
    {
      page && (
        <>
          <link
            rel="alternate"
            hreflang="es"
            href={new URL(routes.es[page], site).toString()}
          />
          <link
            rel="alternate"
            hreflang="en"
            href={new URL(routes.en[page], site).toString()}
          />
          <link
            rel="alternate"
            hreflang="x-default"
            href={new URL(routes.es[page], site).toString()}
          />
        </>
      )
    }

    <!-- Iconografía y fuentes -->
    <link rel="icon" type="image/png" href="/assets/favicon.png" />
    <link rel="stylesheet" href="https://use.typekit.net/lap0far.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/icon?family=Material+Icons"
      rel="stylesheet"
    />

    <ViewTransitions />

    <!--
      Flags on <html>: dark mode (avoids the initial flash) and `motion-ready`,
      which lets the stylesheet hide the elements that JavaScript will reveal.
      View transitions replace the root attributes, so both are re-applied after
      every swap.
    -->
    <script is:inline>
      (() => {
        const applyRootFlags = () => {
          const root = document.documentElement;
          try {
            root.classList.toggle(
              "dark",
              localStorage.getItem("dark_mode") === "true",
            );
          } catch {
            // Storage can be unavailable in private mode; light theme is fine.
          }
          root.classList.add("motion-ready");
        };

        applyRootFlags();
        document.addEventListener("astro:after-swap", applyRootFlags);
      })();
    </script>

    <noscript>
      <style>
        [data-reveal] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-FEPRLMTYFE"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-FEPRLMTYFE");
    </script>
  </head>

  <body
    class="bg-canvas text-ink h-full font-sans antialiased"
  >
    <Header page={page ?? "home"} transition:animate="none" />
    <main class="pt-20">
      <slot />
    </main>
    <Footer transition:animate="none" />
    <FloatingContact transition:animate="none" />

    <script src="../assets/js/motion.js"></script>
  </body>
</html>
