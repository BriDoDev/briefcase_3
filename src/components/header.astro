---
import { getLangFromUrl, routes, useTranslations } from "../i18n/ui";
import Logo from "./logo.astro";
import ThemeToggle from "./theme-toggle.astro";

const { page = "home" } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const menus = [
	{ key: "home", name: t.nav.home },
	{ key: "projects", name: t.nav.projects },
	{ key: "services", name: t.nav.services },
	{ key: "about", name: t.nav.about },
];

const isActive = (key) => key === page;
---

<header id="header" class="fixed top-0 z-50 w-full px-4 pt-4 sm:px-6">
	<div
		class="header-pill flex items-center py-3 pl-7 pr-4 mx-auto max-w-6xl rounded-pill shadow-sm select-none gap-7 bg-surface"
	>
		<Logo href={routes[lang].home} />

		<nav class="items-center hidden text-sm md:flex gap-7">
			{
				menus.map((menu) => (
					<a
						href={routes[lang][menu.key]}
						class:list={[
							"nav-link transition-colors",
							isActive(menu.key)
								? "text-accent-700 font-semibold"
								: "text-muted-strong hover:text-ink",
						]}
						aria-current={isActive(menu.key) ? "page" : undefined}
					>
						{menu.name}
					</a>
				))
			}
		</nav>

		<div class="flex items-center gap-3 ml-auto">
			{/*
				TODO: restore the ES/EN switcher once the English pages are ready.
				The site falls back to Spanish (`defaultLocale: "es"` in
				astro.config.mjs), and /en/* stays reachable by URL meanwhile.

				<div class="hidden seg lg:inline-flex" role="group" aria-label={t.nav.language}>
					<a
						href={routes.es[page]}
						class:list={["seg-opt", lang === "es" && "seg-opt-active"]}
						hreflang="es"
						aria-current={lang === "es" ? "true" : undefined}>ES</a
					>
					<a
						href={routes.en[page]}
						class:list={["seg-opt", lang === "en" && "seg-opt-active"]}
						hreflang="en"
						aria-current={lang === "en" ? "true" : undefined}>EN</a
					>
				</div>
			*/}

			<ThemeToggle />

			<a href={routes[lang].contact} class="hidden btn btn-primary sm:inline-flex">
				{t.nav.cta}
			</a>

			<button
				type="button"
				id="openMenu"
				class="flex justify-center items-center w-10 h-10 transition-colors md:hidden rounded-pill hover:bg-canvas"
				aria-label={t.nav.openMenu}
				aria-expanded="false"
				aria-controls="menu"
			>
				<svg
					class="w-6 h-6 text-ink"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					viewBox="0 0 24 24"
				>
					<path d="M4 8h16M4 16h16"></path>
				</svg>
			</button>
		</div>
	</div>

	<!-- Menú móvil -->
	<div
		id="menu"
		class="hidden p-4 mx-auto mt-3 max-w-6xl shadow-md md:hidden rounded-lg bg-surface"
	>
		<nav class="flex flex-col">
			{
				menus.map((menu) => (
					<a
						href={routes[lang][menu.key]}
						class:list={[
							"py-3 text-sm font-medium",
							isActive(menu.key) ? "text-accent-700" : "text-muted-strong",
						]}
					>
						{menu.name}
					</a>
				))
			}
			<a href={routes[lang].contact} class="mt-3 btn btn-primary btn-block">
				{t.nav.cta}
			</a>
			<div class="flex items-center pt-4">
				<ThemeToggle />
			</div>

			{/*
				TODO: restore the ES/EN switcher here too (see the desktop one above).

				<div class="mt-4 seg self-start" role="group" aria-label={t.nav.language}>
					<a
						href={routes.es[page]}
						class:list={["seg-opt", lang === "es" && "seg-opt-active"]}
						hreflang="es">ES</a
					>
					<a
						href={routes.en[page]}
						class:list={["seg-opt", lang === "en" && "seg-opt-active"]}
						hreflang="en">EN</a
					>
				</div>
			*/}
		</nav>
	</div>
</header>

<script>
  // Bundled (not inline) so this module runs once and keeps `controller`
  // between view transitions; the listeners are rebound on every page load.
  let controller: AbortController | undefined;

  const setupMenu = () => {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    const openMenuBtn = document.getElementById("openMenu");
    const menu = document.getElementById("menu");
    if (!openMenuBtn || !menu) return;

    const setOpen = (open: boolean) => {
      menu.classList.toggle("hidden", !open);
      openMenuBtn.setAttribute("aria-expanded", String(open));
    };

    openMenuBtn.addEventListener(
      "click",
      (e) => {
        e.stopPropagation();
        setOpen(menu.classList.contains("hidden"));
      },
      { signal },
    );

    for (const link of menu.querySelectorAll("a")) {
      link.addEventListener("click", () => setOpen(false), { signal });
    }

    document.addEventListener(
      "click",
      (e) => {
        const target = e.target as Node;
        if (!menu.contains(target) && !openMenuBtn.contains(target)) {
          setOpen(false);
        }
      },
      { signal },
    );
  };

  document.addEventListener("astro:page-load", setupMenu);
</script>
