---
import menus from "../collections/menu.json";
import Logo from "../components/logo.astro";
---

<header
  id="header"
  class="fixed top-0 z-50 w-full h-16 bg-white dark:bg-primary-950 border-b border-primary-200 dark:border-primary-800 transition-all"
>
  <div
    class="flex items-center justify-between h-full max-w-5xl px-6 mx-auto select-none"
  >
    <Logo />

    <nav
      class="relative z-30 flex flex-row-reverse justify-start w-full text-sm sm:justify-end text-primary-500 dark:text-primary-400 sm:flex-row"
    >
      <!-- Botón abrir menú mobile -->
      <button
        type="button"
        id="openMenu"
        class="flex flex-col items-center justify-center w-10 h-10 ml-4 cursor-pointer sm:hidden rounded-lg hover:bg-primary-100 dark:hover:bg-primary-800 transition-colors"
        aria-label="Abrir menú"
      >
        <svg
          class="w-6 h-6 text-primary-700 dark:text-primary-200"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path d="M4 8h16M4 16h16"></path>
        </svg>
      </button>

      <!-- Botón cerrar menú mobile -->
      <button
        type="button"
        id="closeMenu"
        class="hidden flex-col items-center justify-center w-10 h-10 ml-4 cursor-pointer sm:hidden rounded-lg hover:bg-primary-100 dark:hover:bg-primary-800 transition-colors"
        aria-label="Cerrar menú"
      >
        <svg
          class="w-6 h-6 text-primary-700 dark:text-primary-200"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>

      <!-- Menú de navegación -->
      <div
        id="menu"
        class="fixed top-16 ease-out duration-300 w-full left-0 pt-4 pb-4 z-40 flex-col items-end justify-start hidden sm:relative sm:top-0 sm:flex-row sm:flex sm:w-auto sm:pt-0 sm:pb-0"
      >
        <!-- Fondo blur para mobile -->
        <div class="absolute inset-0 sm:hidden px-4">
          <div
            class="relative w-full h-full bg-white dark:bg-primary-950 border border-primary-200 dark:border-primary-800 rounded-lg"
          >
          </div>
        </div>

        {
          menus.map((menu) => (
            <a
              href={menu.url}
              class="relative flex items-center justify-center w-full px-4 py-3 font-medium tracking-tight text-center duration-200 ease-out sm:py-0 sm:mb-0 md:w-auto hover:text-primary-900 dark:hover:text-white"
            >
              {menu.name}
            </a>
          ))
        }
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const openMenuBtn = document.getElementById("openMenu");
    const closeMenuBtn = document.getElementById("closeMenu");
    const menu = document.getElementById("menu");

    if (openMenuBtn && closeMenuBtn && menu) {
      openMenuBtn.addEventListener("click", () => {
        menu.classList.remove("hidden");
        menu.classList.add("flex");
        openMenuBtn.classList.add("hidden");
        closeMenuBtn.classList.remove("hidden");
        closeMenuBtn.classList.add("flex");
      });

      closeMenuBtn.addEventListener("click", () => {
        menu.classList.add("hidden");
        menu.classList.remove("flex");
        closeMenuBtn.classList.add("hidden");
        closeMenuBtn.classList.remove("flex");
        openMenuBtn.classList.remove("hidden");
      });

      // Cerrar menú al hacer click en un enlace
      menu.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          menu.classList.add("hidden");
          menu.classList.remove("flex");
          closeMenuBtn.classList.add("hidden");
          closeMenuBtn.classList.remove("flex");
          openMenuBtn.classList.remove("hidden");
        });
      });

      // Cerrar menú al hacer click fuera
      document.addEventListener("click", (e) => {
        if (
          !menu.contains(e.target) &&
          !openMenuBtn.contains(e.target) &&
          !closeMenuBtn.contains(e.target)
        ) {
          menu.classList.add("hidden");
          menu.classList.remove("flex");
          closeMenuBtn.classList.add("hidden");
          closeMenuBtn.classList.remove("flex");
          openMenuBtn.classList.remove("hidden");
        }
      });
    }
  });
</script>
