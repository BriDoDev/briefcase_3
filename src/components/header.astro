---
import menus from "../collections/menu.json";
import Logo from "../components/logo.astro";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (url) =>
	url === "/" ? pathname === "/" : pathname.startsWith(url);
---

<header id="header" class="fixed top-0 z-50 w-full px-4 pt-4 sm:px-6">
  <div
    class="flex items-center gap-7 max-w-6xl mx-auto pl-7 pr-4 py-3 bg-surface rounded-pill shadow-sm select-none"
  >
    <Logo />

    <nav class="hidden md:flex items-center gap-7 text-sm">
      {
        menus.map((menu) => (
          <a
            href={menu.url}
            class:list={[
              "transition-colors",
              isActive(menu.url)
                ? "text-accent-700 font-semibold"
                : "text-muted-strong hover:text-ink",
            ]}
            aria-current={isActive(menu.url) ? "page" : undefined}
          >
            {menu.name}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3 ml-auto">
      <div class="seg hidden lg:inline-flex" role="group" aria-label="Idioma">
        <label class="seg-opt">
          <input type="radio" name="lang" value="es" checked />
          <span>ES</span>
        </label>
        <label class="seg-opt">
          <input type="radio" name="lang" value="en" />
          <span>EN</span>
        </label>
      </div>

      <a href="/contacto" class="btn btn-primary hidden sm:inline-flex">
        Cuéntame tu proceso
      </a>

      <button
        type="button"
        id="openMenu"
        class="flex items-center justify-center w-10 h-10 rounded-pill md:hidden hover:bg-canvas transition-colors"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="menu"
      >
        <svg
          class="w-6 h-6 text-ink"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path d="M4 8h16M4 16h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Menú móvil -->
  <div
    id="menu"
    class="hidden md:hidden max-w-6xl mx-auto mt-3 p-4 bg-surface rounded-lg shadow-md"
  >
    <nav class="flex flex-col">
      {
        menus.map((menu) => (
          <a
            href={menu.url}
            class:list={[
              "py-3 text-sm font-medium",
              isActive(menu.url) ? "text-accent-700" : "text-muted-strong",
            ]}
          >
            {menu.name}
          </a>
        ))
      }
      <a href="/contacto" class="btn btn-primary btn-block mt-3">
        Cuéntame tu proceso
      </a>
    </nav>
  </div>
</header>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const openMenuBtn = document.getElementById("openMenu");
    const menu = document.getElementById("menu");
    if (!openMenuBtn || !menu) return;

    const setOpen = (open) => {
      menu.classList.toggle("hidden", !open);
      openMenuBtn.setAttribute("aria-expanded", String(open));
    };

    openMenuBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      setOpen(menu.classList.contains("hidden"));
    });

    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("click", (e) => {
      if (!menu.contains(e.target) && !openMenuBtn.contains(e.target)) {
        setOpen(false);
      }
    });
  });
</script>
