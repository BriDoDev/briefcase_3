---
import { getLangFromUrl, routes, useTranslations } from "../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const r = routes[lang];

const socials = [
	{ name: "YouTube", url: "#" },
	{ name: "TikTok", url: "#" },
	{ name: "Instagram", url: "#" },
	{ name: "LinkedIn", url: "https://www.linkedin.com/in/bridodev/" },
	{ name: "GitHub", url: "https://github.com/bridodev" },
];
---

<footer class="px-4 pb-6 sm:px-6">
  <div class="max-w-6xl mx-auto p-10 md:p-14 bg-ink-deep rounded-lg text-white">
    <div class="flex flex-col gap-10 md:flex-row md:items-end md:justify-between">
      <div class="flex flex-col gap-4 max-w-xl">
        <h2 class="text-3xl md:text-4xl font-semibold tracking-tighter">
          {t.footer.title}
        </h2>
        <p class="text-white/70">
          {t.footer.body}
        </p>
        <div class="flex flex-col sm:flex-row gap-3 pt-2">
          <a
            href={r.contact}
            class="btn"
            style="background:#fff; color:var(--color-ink)"
          >
            {t.nav.cta}
          </a>
          <a href={r.projects} class="btn btn-on-dark">{t.common.seeProjects}</a>
        </div>
      </div>

      <div class="flex flex-col gap-4 text-sm">
        <a href="mailto:contacto@brian-dominguez.dev" class="text-white/80 hover:text-white">
          contacto@brian-dominguez.dev
        </a>
        <a href="https://wa.me/5215580858318" class="text-white/80 hover:text-white">
          WhatsApp · 55 8085 8318
        </a>
        <div class="flex flex-wrap gap-4 pt-2">
          {
            socials.map((social) => (
              <a href={social.url} class="text-white/70 hover:text-white">
                {social.name}
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <p class="pt-10 mt-10 border-t border-white/10 text-xs text-white/50">
      © {new Date().getFullYear()} Brian Domínguez Vázquez · {t.footer.rights}
    </p>
  </div>
</footer>
