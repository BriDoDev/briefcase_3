    class="absolute top-0 left-0 w-1/2 h-auto bg-primary-50 dark:bg-primary-900/50"
  >
    <div
      class="flex flex-col w-full h-full border-t border-l divide-y divide-dashed divide-primary-200 dark:divide-primary-700 border-primary-200 dark:border-primary-800"
    >
      <SquareLine />
      <SquareLine />
      <SquareLine />
      <SquareLine />
      <SquareLine />
      <SquareLine />
    </div>
  </div>

  <div
    class="absolute top-0 right-0 w-1/2 h-auto bg-primary-50 dark:bg-primary-900/50"
  >
    <div
      class="flex flex-col w-full h-full border-t border-l divide-y divide-dashed divide-primary-200 dark:divide-primary-700 border-primary-200 dark:border-primary-800"
    >
      <SquareLine />
      <SquareLine />
      <SquareLine />
      <SquareLine />
      <SquareLine />
      <SquareLine />
    </div>
  </div>
</div>
