---
const { name, description, url, image } = Astro.props;
---

<a
  href={url}
  target="_blank"
  class="block group p-6 border border-primary-100 dark:border-primary-800 hover:border-accent dark:hover:border-accent transition-colors duration-200"
>
  <span class="block w-full">
    <img src={image} class="w-full h-auto aspect-[16/9] object-cover" />
  </span>
  <span class="block w-full mt-5">
    <span
      class="flex items-center mb-1 text-base font-semibold tracking-tight text-primary-900 dark:text-white"
    >
      <span>{name}</span>
      <svg
        class="w-4 h-4 ml-1 -rotate-45 text-primary-400 group-hover:text-accent transition-colors"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </span>
    <span class="text-sm text-primary-600 dark:text-primary-400 block truncate"
      >{description}</span
    >
  </span>
</a>
