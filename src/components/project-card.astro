---
const { project, label = "Abrir el proyecto →", ...rest } = Astro.props;
---

<a
  href={project.url}
  target="_blank"
  rel="noopener noreferrer"
  class="surface-card group hover:shadow-md"
  {...rest}
>
  <div class="overflow-hidden aspect-[16/10] bg-canvas" data-cursor-label={label}>
    <img
      src={project.image}
      alt={project.name}
      loading="lazy"
      class="object-cover w-full h-full transition-transform duration-500 ease-out group-hover:scale-[1.04]"
    />
  </div>
  <div class="flex flex-col gap-2 p-7">
    <h3 class="text-lg font-semibold tracking-tight text-ink">{project.name}</h3>
    <p class="text-sm text-muted line-clamp-4">{project.description}</p>
    <span
      class="inline-block mt-1 text-sm font-semibold transition-transform duration-200 ease-out text-accent-700 group-hover:translate-x-1"
      >{label}</span
    >
  </div>
</a>
