---
import { Icon } from "astro-icon/components";
---

<div
  class="fixed bottom-6 right-6 z-50 flex flex-col items-end gap-3"
  id="fab-wrapper"
>
  <!-- Opciones de contacto -->
  <div
    id="fab-options"
    class="flex flex-col justify-end items-end gap-3 opacity-0 scale-0 transform transition-all duration-300 ease-out pointer-events-none"
  >
    <a
      href="https://wa.me/5215580858318"
      target="_blank"
      rel="noopener"
      class="flex items-center gap-3 px-5 py-3 rounded-pill bg-ink-deep text-white text-sm font-medium shadow-sm hover:bg-ink transition-colors"
    >
      <Icon name="simple-icons:whatsapp" class="w-5 h-5" />
      <span class="hidden md:inline">WhatsApp</span>
    </a>
    <a
      href="mailto:contacto@brian-dominguez.dev"
      class="w-max flex items-center gap-3 px-5 py-3 rounded-pill bg-surface text-ink text-sm font-medium border border-divider shadow-sm hover:bg-canvas transition-colors"
    >
      <span class="material-icons text-lg">mail</span>
      <span class="hidden md:inline">Correo</span>
    </a>
  </div>

  <!-- Botón principal -->
  <button
    type="button"
    id="fab-toggle"
    class="relative z-10 flex items-center justify-center w-14 h-14 rounded-pill bg-accent text-white font-semibold shadow-md hover:bg-accent-700 hover:scale-105 transition-all duration-200"
    aria-label="Contacto"
    aria-expanded="false"
    aria-controls="fab-options"
  >
    <span class="material-icons text-xl">chat</span>
  </button>
</div>

<script>
  // Bundled (not inline) so this module runs once and keeps `controller`
  // between view transitions; the listeners are rebound on every page load.
  let controller: AbortController | undefined;

  const setupFab = () => {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    const fabToggle = document.getElementById("fab-toggle");
    const fabOptions = document.getElementById("fab-options");
    const fabWrapper = document.getElementById("fab-wrapper");
    if (!fabToggle || !fabOptions || !fabWrapper) return;

    const setOpen = (open: boolean) => {
      fabOptions.classList.toggle("opacity-100", open);
      fabOptions.classList.toggle("scale-100", open);
      fabOptions.classList.toggle("opacity-0", !open);
      fabOptions.classList.toggle("scale-0", !open);
      fabOptions.classList.toggle("pointer-events-none", !open);
      fabToggle.setAttribute("aria-expanded", String(open));
    };

    fabToggle.addEventListener(
      "click",
      () => setOpen(fabOptions.classList.contains("opacity-0")),
      { signal },
    );

    document.addEventListener(
      "click",
      (e) => {
        if (!fabWrapper.contains(e.target as Node)) setOpen(false);
      },
      { signal },
    );
  };

  document.addEventListener("astro:page-load", setupFab);
</script>
