---
const { link, text, variant = "primary", size = "default" } = Astro.props;

const baseClasses =
	"inline-flex items-center justify-center relative font-semibold transition-colors duration-150 focus:outline-none focus:ring-2 focus:ring-offset-2 w-full sm:w-auto";

const sizeClasses = {
	small: "min-h-[36px] px-4 text-sm",
	default: "min-h-[44px] px-6 text-sm",
	large: "min-h-[52px] px-8 text-base",
};

const variantClasses = {
	primary:
		"bg-primary-900 dark:bg-white text-white dark:text-primary-900 hover:bg-primary-700 dark:hover:bg-primary-200 focus:ring-primary-500",

	secondary:
		"bg-transparent border-2 border-primary-900 dark:border-white text-primary-900 dark:text-white hover:bg-primary-50 dark:hover:bg-primary-800 focus:ring-primary-500",

	ghost:
		"bg-transparent text-primary-600 dark:text-primary-400 hover:bg-primary-50 dark:hover:bg-primary-800 hover:text-primary-900 dark:hover:text-white focus:ring-primary-500",

	accent: "bg-accent text-white hover:bg-accent-dark focus:ring-accent",
};

const finalClass = `${baseClasses} ${sizeClasses[size]} ${variantClasses[variant]}`;
---

<a href={link} class={finalClass}>
  <span class="relative">{text}</span>
</a>
