---
const { link, text, variant = "primary", size = "default" } = Astro.props;

const baseClasses =
  "inline-flex items-center justify-center relative rounded-lg font-medium transition-all duration-200 ease-out focus:outline-none focus:ring-2 focus:ring-offset-2 w-full sm:w-auto";

const sizeClasses = {
  small: "min-h-[36px] px-4 text-sm",
  default: "min-h-[44px] px-6 text-sm",
  large: "min-h-[52px] px-8 text-base",
};

const variantClasses = {
  primary:
    "bg-primary-900 dark:bg-white text-white dark:text-primary-900 hover:bg-primary-700 dark:hover:bg-primary-100 focus:ring-primary-500 shadow-sm",

  secondary:
    "bg-transparent border border-primary-200 dark:border-primary-700 text-primary-900 dark:text-white hover:bg-primary-50 dark:hover:bg-primary-800 focus:ring-primary-500",

  ghost:
    "bg-transparent text-primary-600 dark:text-primary-300 hover:bg-primary-50 dark:hover:bg-primary-800 hover:text-primary-900 dark:hover:text-white focus:ring-primary-500",

  accent:
    "bg-accent text-white hover:bg-accent-dark focus:ring-accent shadow-sm",
};

const finalClass = `${baseClasses} ${sizeClasses[size]} ${variantClasses[variant]}`;
---

<a href={link} class={finalClass}>
  <span class="relative">{text}</span>
</a>
