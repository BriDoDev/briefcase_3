---
const { items = [], bgId = "", type = "", title = "" } = Astro.props;
const swiperClass = `swiper-${type}`;
---

<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
/>

<section
  id={type}
  class="min-h-[80svh] px-6 md:px-12 py-16 relative flex flex-col justify-center items-center gap-12"
>
  <div class="relative z-10 text-center space-y-4">
    <h2
      class="text-3xl md:text-4xl font-bold text-primary-900 dark:text-white tracking-tight"
    >
      {title}
    </h2>
    <p class="text-primary-500 dark:text-primary-400 max-w-2xl mx-auto">
      Proyectos donde el diseño estratégico generó resultados de negocio
      medibles.
    </p>
  </div>

  <div class={`relative w-full max-w-5xl z-10 ${swiperClass}-wrapper`}>
    <div class={`swiper !overflow-visible ${swiperClass}`} data-bg-id={bgId}>
      <div class="swiper-wrapper">
        {
          items.map((item) => (
            <div class="swiper-slide h-auto w-full flex items-center justify-center p-4">
              <div class="card w-full h-auto flex flex-col xl:flex-row items-center gap-8 p-8 max-w-4xl">
                <img
                  src={item.image}
                  alt={item.name}
                  class="w-full max-w-[280px] md:max-w-[320px] rounded-lg border border-primary-100 dark:border-primary-700 object-contain"
                />
                <div class="text-center xl:text-left w-full max-w-xl space-y-4">
                  <h3 class="text-xl md:text-2xl font-semibold text-primary-900 dark:text-white">
                    {item.name}
                  </h3>
                  <p class="text-primary-500 dark:text-primary-400 text-sm leading-relaxed">
                    {item.description.trim()}
                  </p>
                  {item.url && (
                    <a
                      href={item.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 text-sm font-medium text-accent hover:text-accent-dark transition-colors"
                    >
                      Ver caso de estudio
                      <svg
                        class="w-4 h-4"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M17 8l4 4m0 0l-4 4m4-4H3"
                        />
                      </svg>
                    </a>
                  )}
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <!-- Cleaner navigation -->
      <div class="flex justify-center gap-4 mt-8">
        <button
          class={`swiper-button-prev-${type} w-10 h-10 rounded-lg bg-primary-100 dark:bg-primary-800 flex items-center justify-center hover:bg-primary-200 dark:hover:bg-primary-700 transition-colors`}
        >
          <svg
            class="w-5 h-5 text-primary-600 dark:text-primary-300"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 19l-7-7 7-7"></path>
          </svg>
        </button>
        <div class={`swiper-pagination-${type} flex justify-center items-center gap-2`}></div>
        <button
          class={`swiper-button-next-${type} w-10 h-10 rounded-lg bg-primary-100 dark:bg-primary-800 flex items-center justify-center hover:bg-primary-200 dark:hover:bg-primary-700 transition-colors`}
        >
          <svg
            class="w-5 h-5 text-primary-600 dark:text-primary-300"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 5l7 7-7 7"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

{
  type === "certifications" && (
    <script type="module">
      import Swiper from "https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.mjs";

      const container = document.querySelector(".swiper-certifications");

      new Swiper(container, {
        loop: true,
        autoplay: {
          delay: 10000,
          disableOnInteraction: false,
        },
        pagination: {
          el: ".swiper-pagination-certifications",
          clickable: true,
          bulletClass:
            "w-2 h-2 rounded-full bg-primary-300 dark:bg-primary-600 cursor-pointer transition-all",
          bulletActiveClass: "!bg-accent w-6",
        },
        navigation: {
          nextEl: ".swiper-button-next-certifications",
          prevEl: ".swiper-button-prev-certifications",
        },
      });
    </script>
  )
}

{
  type === "projects" && (
    <script type="module">
      import Swiper from "https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.mjs";

      const container = document.querySelector(".swiper-projects");

      new Swiper(container, {
        loop: true,
        autoplay: {
          delay: 10000,
          disableOnInteraction: false,
        },
        pagination: {
          el: ".swiper-pagination-projects",
          clickable: true,
          bulletClass:
            "w-2 h-2 rounded-full bg-primary-300 dark:bg-primary-600 cursor-pointer transition-all",
          bulletActiveClass: "!bg-accent w-6",
        },
        navigation: {
          nextEl: ".swiper-button-next-projects",
          prevEl: ".swiper-button-prev-projects",
        },
      });
    </script>
  )
}

<style>
  .swiper-button-next,
  .swiper-button-prev {
    display: none !important;
  }
  .swiper-pagination {
    position: static !important;
  }
</style>
