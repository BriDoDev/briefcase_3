---
import Media from "./media.astro";

const { item } = Astro.props;
const href = item.hasDetail ? `/casos/${item.slug}` : "/contacto";
---

<article class="surface-card">
  <div class="h-48 shrink-0">
    <Media label={item.hasDetail ? `Miniatura ${item.number}` : "Miniatura"} src={item.image} />
  </div>
  <div class="flex flex-col gap-3 p-7">
    <span class:list={["tag self-start", item.hasDetail ? "tag-accent" : "tag-outline"]}>
      {item.hasDetail ? `${item.number} · ${item.status}` : item.status}
    </span>
    <h3 class="text-lg font-semibold tracking-tight text-ink">{item.title}</h3>
    <p class="text-sm text-muted">{item.summary}</p>
    <a href={href} class="btn btn-ghost self-start mt-1">
      {item.hasDetail ? "Ver el caso →" : "Proponer un negocio →"}
    </a>
  </div>
</article>
